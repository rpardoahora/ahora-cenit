# Copia este fichero a .env.cenit y rellena los valores reales.
# Variables usadas por docker-compose-cenit.yml (stack sqlserver + app,
# desplegado desde la imagen publicada en ghcr.io/rpardoahora/ahora-cenit).

# ---------- Imagen ----------
# Tag de la imagen a desplegar (por defecto "latest", la última build de main).
# Usa un tag "sha-<commit>" para fijar una versión concreta.
IMAGE_TAG=latest

# ---------- Dominio ----------
# Dominio público de la app (usado por el router de Traefik y como BaseDomain).
DOMAIN=ahoracenit.com

# ---------- Base de datos ----------
DB_SA_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=

# ---------- Portainer ----------
# La API usa Portainer para desplegar/parar/borrar instancias de producto.
PORTAINER_URL=https://portainer.ahoracenit.com
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=

# ---------- Usuario administrador (seed inicial) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Autenticación ----------
REQUIRE_EMAIL_CONFIRMATION=true
PUBLIC_BASE_URL=https://ahoracenit.com

# ---------- SMTP (envío de emails: confirmación, recuperación de contraseña) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
