DOMAIN=ahoracenit.com

DB_SA_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-a-long-random-secret

PORTAINER_URL=http://portainer:9000
PORTAINER_API_KEY=replace-with-a-real-portainer-api-key
PORTAINER_ENDPOINT_ID=1

ADMIN_EMAIL=admin@ahoracenit.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Confirmación de email al registrarse: recomendado activarla en producción.
REQUIRE_EMAIL_CONFIRMATION=true
PUBLIC_BASE_URL=https://ahoracenit.com

# SMTP real (si se deja vacío, los emails solo se escriben en el log, no se envían).
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@ahoracenit.com
