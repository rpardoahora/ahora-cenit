DOMAIN=ahoracenit.localhost

DB_SA_PASSWORD=changeme-dev-only

JWT_SECRET=changeme-dev-only

PORTAINER_URL=http://portainer:9000
PORTAINER_API_KEY=replace-with-a-real-portainer-api-key
PORTAINER_ENDPOINT_ID=1

ADMIN_EMAIL=admin@ahoracenit.localhost
ADMIN_PASSWORD=changeme-dev-only

# Confirmación de email al registrarse: cómodo desactivarla en dev.
REQUIRE_EMAIL_CONFIRMATION=false
PUBLIC_BASE_URL=http://ahoracenit.localhost

# SMTP real (si se deja vacío, los emails solo se escriben en el log, no se envían).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ahoracenit.localhost

# Observabilidad (OpenTelemetry / OpenObserve). Deja OTEL_EXPORTER_OTLP_ENDPOINT
# en blanco para no exportar la auditoría (alta/baja/cambios de Usuario,
# Producto y Aplicación) como traces+metrics+logs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
# Credenciales del usuario root de OpenObserve (login del panel y auth de ingesta OTLP).
# La contraseña debe tener mayúscula, minúscula, dígito y símbolo (8-128 caracteres).
OPENOBSERVE_ROOT_EMAIL=admin@ahoracenit.localhost
OPENOBSERVE_ROOT_PASSWORD=changeme-dev-only
